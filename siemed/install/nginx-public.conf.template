# Публичный порт: только сайт записи. NAT/DNAT на фаерволе — сюда.
# Подключается из /etc/nginx/sites-enabled/

server {
    listen PUBLIC_PORT default_server;
    listen [::]:PUBLIC_PORT default_server;
    server_name _;

    location /static/ {
        alias /opt/siemed/app/static/;
        expires 7d;
    }

    location / {
        proxy_pass http://127.0.0.1:PUBLIC_PORT_APP;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    }
}
